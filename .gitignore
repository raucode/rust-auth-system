# Cargo (Rust)
target/
**/*.rs.bk

# Cargo.lock SÍ se versiona: esto es un binario, no una biblioteca. Sin él, dos
# máquinas resuelven dependencias distintas y «en la mía funciona» deja de poder
# comprobarse.

# Frontends de prueba
node_modules/
web/*/dist/
# Cachés de Vite: una por frontend, para que los tres puedan arrancar a la vez
.vite*/

# El secreto compartido entre el proxy y los servicios de detrás. La
# configuración se versiona; el secreto no, igual que el .env.
despliegue/proxy-secreto.conf

# Lo que nginx escribe al ejecutarse: pid, logs y ficheros temporales. La
# configuración sí se versiona; el estado de una ejecución concreta, no.
despliegue/logs/
despliegue/temp/
despliegue/arranque/
despliegue/client_body_temp/
despliegue/*_temp/

# Archivos de entorno
.env
.env.local
.env.*.local

# Archivos de editores y IDEs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Binarios locales
*.exe
*.dll
*.so
*.dylib

# Archivos temporales
*.tmp
*.swp
