DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/rust_auth
SQLX_MIGRATIONS_TABLE=_sqlx_migrations
# --- Claves ------------------------------------------------------------------
#
# Son DOS y cada una protege una mitad: con la de acceso se pueden forjar tokens de
# diez minutos, pero no convertirlos en sesión duradera (un refresh además tiene que
# existir como fila en la base); con la del refresh no se firma ningún acceso.
#
# Ninguna tiene valor por defecto, y el servicio no arranca si falta una o si mide
# menos de 32 bytes. Una clave de reserva es una clave conocida.
#
# Tienen que ser DISTINTAS: si son iguales el arranque falla, porque separarlas es
# todo el sentido de que sean dos.
#
#   openssl rand -base64 48

# Firma el JWT de acceso.
JWT_ACCESS_SECRET=

# Da clave al resumen con el que se guarda y se busca el token de refresco.
# Cambiarla invalida todos los refrescos vivos: las sesiones abiertas caen al login.
REFRESH_TOKEN_PEPPER=

# Dónde escucha el servidor. Por defecto 127.0.0.1:8080, no 0.0.0.0:
# publicarlo hacia fuera tiene que ser una decisión explícita.
# El 8081 evita chocar con el visor de infraestructura, que usa el 8080.
BIND_ADDR=127.0.0.1:8081

# Orígenes permitidos en CORS, separados por comas.
# Por defecto, los dos frontends de web/.
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# --- Cookies -----------------------------------------------------------------

# Atributo Secure. Por defecto true.
# En false SOLO para desarrollo local sin HTTPS: sin Secure la cookie también
# viaja por HTTP en claro. Y ojo, con true y sin HTTPS el navegador la descarta,
# así que el login responde 200 y no deja sesión.
COOKIE_SECURE=false

# Atributo HttpOnly. Por defecto true.
#
# En false el JavaScript de la página puede leer la cookie de sesión — y con ella
# cualquier script que se cuele, sea un XSS o una dependencia comprometida.
# No hace falta desactivarlo para saber si hay sesión: eso lo responde
# GET /auth/verify, que es como lo hacen los dos frontends de web/.
COOKIE_HTTPONLY=false

# --- Administrador inicial ----------------------------------------------------

# Se crea al arrancar si no existe ya. Resuelve el problema del primer usuario:
# sin nadie dado de alta no se puede entrar, y sin entrar no se puede dar de alta.
#
# Es idempotente: arrancar dos veces no duplica nada ni sobrescribe la contraseña
# si se ha cambiado después. Deja las dos vacías para no crear ninguno.
ADMIN_EMAIL=admin@valedocerrado.com.br
ADMIN_PASSWORD=cambia-esta-contrasena
